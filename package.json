{
  "name": "ke-xiaoben",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "build:ios": "eas build --platform ios --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios --profile production",
    "asc:status": "node scripts/asc-status.mjs",
    "asc:prep": "node scripts/asc-version-metadata.mjs && node scripts/asc-review-contact.mjs && node scripts/asc-version-bind.mjs && node scripts/asc-screenshots-fix.mjs",
    "asc:review-notes": "node scripts/asc-review-contact.mjs",
    "asc:review-attach": "node scripts/asc-review-attachment-upload.mjs",
    "asc:imessage-clean": "node scripts/asc-screenshots-fix.mjs --delete",
    "icon:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-icon.ps1",
    "build:ios:icon": "npm run icon:apply && npx eas-cli build --platform ios --profile production --non-interactive",
    "submit:ios:latest": "npx eas-cli submit --platform ios --profile production --latest --non-interactive",
    "review:recording": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-review-screenrecording.ps1"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~18.0.0",
    "expo-iap": "^6.4.3",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
